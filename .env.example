# Copiar a .env y completar. Nunca subir .env a git.

# --- Django ---
DJANGO_SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# --- Base de datos (local: postgres del docker-compose.dev; AWS: endpoint de RDS) ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=cofrial
DB_USER=cofrial_admin
DB_PASSWORD=cambia-esto

# --- IA (https://console.groq.com) ---
GROQ_API_KEY=
# Revisar en console.groq.com/docs/models qué modelos gratuitos están vigentes
GROQ_MODEL=llama-3.1-8b-instant

# --- Datos demo ---
DEMO_PASSWORD=cambia-esto

# --- Simulador IoT ---
CAMION_DESDE=1
CAMION_HASTA=10
INTERVALO_SEG=5
PROB_FALLA=0.02
