# Copiar a iot-simulator/.env y completar. Nunca subir .env a git.

# --- Base de datos ---
# En AWS: el endpoint de RDS y el puerto 5432.
# En tu PC: DB_HOST=host.docker.internal y DB_PORT = el puerto publicado del Postgres local (DB_PORT del .env raíz).
DB_HOST=cofrial-db.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=cofrial
DB_USER=cofrial_admin
DB_PASSWORD=cambia-esto

# --- Simulación (CAMION_DESDE y CAMION_HASTA los fija docker-compose.yml en cada contenedor) ---
INTERVALO_SEG=5
PROB_FALLA=0.02
