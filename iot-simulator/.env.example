# Solo para probar el simulador en tu PC: copiar a iot-simulator/.env y completar. Nunca subir .env a git.
# En la EC2 IoT no hace falta: el simulador lee el .env de la raiz del repositorio.

# Le indica a docker compose que use este archivo en vez del .env de la raiz
IOT_ENV_FILE=.env

# --- Base de datos ---
# DB_HOST=host.docker.internal llega al Postgres local; DB_PORT = el puerto publicado (DB_PORT del .env raíz).
DB_HOST=host.docker.internal
DB_PORT=5432
DB_NAME=cofrial
DB_USER=cofrial_admin
DB_PASSWORD=cambia-esto

# --- Simulación (CAMION_DESDE y CAMION_HASTA los fija docker-compose.yml en cada contenedor) ---
INTERVALO_SEG=5
PROB_FALLA=0.02
